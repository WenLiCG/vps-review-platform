{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "public-dto/v2",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "public-dto/v2"
    },
    "offers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "offer_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "post_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "canonical_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "vendor_raw": {
            "type": [
              "string",
              "null"
            ]
          },
          "published_date": {
            "type": [
              "string",
              "null"
            ]
          },
          "published_tz": {
            "type": [
              "string",
              "null"
            ]
          },
          "review_date": {
            "type": [
              "string",
              "null"
            ]
          },
          "review_date_precision": {
            "type": [
              "string",
              "null"
            ]
          },
          "tested_at_beijing": {
            "type": [
              "string",
              "null"
            ]
          },
          "aff_url": {
            "type": "null"
          },
          "plan_label": {
            "type": [
              "string",
              "null"
            ]
          },
          "vcpu": {
            "type": [
              "integer",
              "null"
            ]
          },
          "memory_mb": {
            "type": [
              "number",
              "null"
            ]
          },
          "disk_total_value": {
            "type": [
              "number",
              "null"
            ]
          },
          "disk_total_unit": {
            "type": [
              "string",
              "null"
            ]
          },
          "disk_type": {
            "type": [
              "string",
              "null"
            ]
          },
          "traffic_value": {
            "type": [
              "number",
              "null"
            ]
          },
          "traffic_unit": {
            "type": [
              "string",
              "null"
            ]
          },
          "port_speed_mbps": {
            "type": [
              "number",
              "null"
            ]
          },
          "location": {
            "type": "object",
            "properties": {
              "raw": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "continent": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "city": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "country": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "raw",
              "continent",
              "city",
              "country"
            ],
            "additionalProperties": false
          },
          "price": {
            "type": "object",
            "properties": {
              "amount": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "currency": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "billing_period_months": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "term_role": {
                "type": [
                  "string",
                  "null"
                ],
                "enum": [
                  "first_term",
                  "renewal",
                  "unknown",
                  null
                ]
              },
              "monthly_equivalent": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "price_status": {
                "type": "string",
                "enum": [
                  "known",
                  "unknown",
                  "partial"
                ]
              }
            },
            "required": [
              "amount",
              "currency",
              "billing_period_months",
              "term_role",
              "monthly_equivalent",
              "price_status"
            ],
            "additionalProperties": false
          },
          "observations_summary": {
            "type": "object",
            "properties": {
              "geekbench6_single": {
                "type": [
                  "number",
                  "null"
                ]
              }
            },
            "required": [
              "geekbench6_single"
            ],
            "additionalProperties": false
          },
          "conflict_flags": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            }
          },
          "summary_text": {
            "type": [
              "string",
              "null"
            ]
          },
          "limited_claim": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "review_date_tz": {
            "type": "string"
          },
          "conflicts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string"
                },
                "resolution": {
                  "type": "string"
                },
                "values": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "source": {
                        "type": "string"
                      },
                      "raw": {
                        "type": "string"
                      },
                      "normalized_mb_candidate": {
                        "type": [
                          "number",
                          "null"
                        ]
                      }
                    },
                    "required": [
                      "source",
                      "raw",
                      "normalized_mb_candidate"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "field",
                "resolution",
                "values"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "offer_id",
          "post_id",
          "canonical_url",
          "vendor_raw",
          "published_date",
          "published_tz",
          "review_date",
          "review_date_precision",
          "tested_at_beijing",
          "aff_url",
          "plan_label",
          "vcpu",
          "memory_mb",
          "disk_total_value",
          "disk_total_unit",
          "disk_type",
          "traffic_value",
          "traffic_unit",
          "port_speed_mbps",
          "location",
          "price",
          "observations_summary",
          "conflict_flags",
          "summary_text",
          "limited_claim",
          "review_date_tz",
          "conflicts"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "offers"
  ],
  "additionalProperties": false
}
